{
  "name": "core-arena-3d",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8740 --strictPort",
    "dev:environment-test": "vite --mode environment-test --host 127.0.0.1 --port 8750 --strictPort",
    "build:environment-test": "npm run typecheck && vite build --mode environment-test --outDir dist-environment-test",
    "build:environment-preview": "npm run typecheck && vite build --mode environment-preview --outDir dist-environment-preview",
    "preview:environment-test": "vite preview --mode environment-test --outDir dist-environment-test --host 127.0.0.1 --port 8751 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:test": "npm run typecheck && vite build --mode test --outDir dist-test",
    "build:adventure-preview": "npm run typecheck && vite build --mode adventure-preview --outDir dist-preview",
    "preview": "vite preview --host 127.0.0.1 --port 8743 --strictPort",
    "preview:test": "vite preview --outDir dist-test --host 127.0.0.1 --port 8744 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "qa:arena:soak": "tsx scripts/qa/arenaSoak.ts",
    "test:browser": "npm run build:test && playwright test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
