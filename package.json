{
  "name": "core-arena-3d",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8740 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:test": "npm run typecheck && vite build --mode test --outDir dist-test",
    "preview": "vite preview --host 127.0.0.1 --port 8743 --strictPort",
    "preview:test": "vite preview --outDir dist-test --host 127.0.0.1 --port 8744 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build:test && playwright test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
